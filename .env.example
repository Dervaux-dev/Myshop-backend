# MyShop Backend environment template
# Copy to .env and fill in real values.

# --- PostgreSQL ---
# NOTE: local PostgreSQL 17 here listens on port 5433, not the default 5432.
# Option 1: single connection string (preferred)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/myshop
# Option 2: individual params (used when DATABASE_URL is empty)
PGHOST=localhost
PGPORT=5433
PGDATABASE=myshop
PGUSER=postgres
PGPASSWORD=postgres

# --- Security ---
# Long random string for JWT signing. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Shared secret between this backend and the Python payment service.
# It secures the /api/payments/* webhook. Use a long random string.
PAYMENT_API_KEY=change_me_to_a_long_random_string

# Base URL where the receipt QR sends the customer to pay.
# Set this to your mypayment frontend URL (dev: http://localhost:5173 | production: your deployed domain).
# Buyer's phone opens: <PAYMENT_BASE_URL>/?ref=<paymentRef>&amount=<amount>&currency=RWF
PAYMENT_BASE_URL=http://localhost:5173

# --- Runtime ---
# URL base where the app is served (used by /api/payments webhook / CORS allow-list)
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
# Comma-separated CORS allow-list for browser builds in production
ALLOWED_ORIGINS=